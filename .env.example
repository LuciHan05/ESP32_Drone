# Supabase Dashboard > Connect / Project Settings > API Keys.
# Public publishable key only. Never use service_role or a secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy alternative when the project only provides an anon public key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
